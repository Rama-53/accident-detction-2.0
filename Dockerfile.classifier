FROM python:3.10-slim

# Install system dependencies (needed for OpenCV and Tensorflow extras)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY requirements.classifier.txt .
RUN pip install --upgrade pip && pip install -r requirements.classifier.txt

# Copy source code
COPY . .

CMD ["python", "classifier_subscriber_async.py"]
