# API URL for the accident detection backend (services/api_server.py).
# Leave empty to auto-detect: API will be at http://<same-host>:8000
#
# For Docker: set this to where your api_server is reachable, e.g.:
#   VITE_API_URL=http://localhost:8000
#   VITE_API_URL=http://host.docker.internal:8000
#   VITE_API_URL=http://192.168.1.5:8000
VITE_API_URL=
